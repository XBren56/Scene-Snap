# Copy to .env locally, then replace every placeholder. Never commit the real .env file.
SCENESNAP_SECRET_KEY=replace-with-a-long-random-value
SCENESNAP_DATABASE=instance/scenesnap.sqlite3
SCENESNAP_CEO_EMAIL=owner@example.com
SCENESNAP_CEO_PASSWORD=replace-with-a-unique-strong-password
SCENESNAP_DEV_MODE=1
SCENESNAP_BASE_URL=http://127.0.0.1:5000
SCENESNAP_HOURLY_RATE=25

# Optional SMTP for verification and employee invite emails. If omitted in dev mode,
# the server returns a one-time link for local testing. In production SMTP is required.
SCENESNAP_SMTP_HOST=
SCENESNAP_SMTP_PORT=587
SCENESNAP_SMTP_USER=
SCENESNAP_SMTP_PASSWORD=
SCENESNAP_SMTP_FROM=
SCENESNAP_SMTP_STARTTLS=1
